# Airtable Configuration
# Personal Access Token (PAT) requires: data.records:read, data.records:write, schema.bases:read, schema.bases:write
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=

# ---------------------------------------------------------------------------
# LLM provider for the specialist agents (pipeline/pipeline_runner.py --live)
#
# Any OpenAI-compatible endpoint works; pick one, uncomment it, set LLM_API_KEY.
# Free options:
#
#   Groq          console.groq.com/keys           free tier, no card, fastest
#     LLM_BASE_URL=https://api.groq.com/openai/v1
#     LLM_MODEL=openai/gpt-oss-120b          (or openai/gpt-oss-20b for a smaller/faster model)
#     Groq's model roster changes over time - check console.groq.com/docs/models
#     or `curl -s -H "Authorization: Bearer $LLM_API_KEY" https://api.groq.com/openai/v1/models`
#     if a model comes back 404.
#
#   Google AI Studio   aistudio.google.com/apikey      generous free tier
#     LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#     LLM_MODEL=gemini-2.0-flash
#
#   Cerebras      cloud.cerebras.ai               free tier, very fast
#     LLM_BASE_URL=https://api.cerebras.ai/v1
#     LLM_MODEL=llama-3.3-70b
#
#   OpenRouter    openrouter.ai/keys              models suffixed ":free"
#     LLM_BASE_URL=https://openrouter.ai/api/v1
#     LLM_MODEL=<check openrouter.ai/models?max_price=0 for the current roster>
#
#   Ollama        ollama.com                      fully local, no key needed
#     LLM_BASE_URL=http://localhost:11434/v1
#     LLM_MODEL=llama3.1
# ---------------------------------------------------------------------------
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# Anthropic key for the Make.com scenario modules (make_scenario/make_blueprint.json)
ANTHROPIC_API_KEY=

# Port configuration
PORT=3000
